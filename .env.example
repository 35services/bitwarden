# Copy to .env and adjust. .env holds secrets: never share or commit it.

# --- Server ---------------------------------------------------------------
# Public URL clients use: Tailscale name + /vaultwarden sub-path, served by
# Caddy (../caddy). The path must match the /vaultwarden block in ../caddy/Caddyfile.
DOMAIN=https://host.tailnet-name.ts.net/vaultwarden

# Localhost port Vaultwarden listens on (Caddy proxies to it).
VAULTWARDEN_PORT=8080

TZ=UTC

# "latest" follows upstream; pin (e.g. 1.34.3) for controlled upgrades.
VAULTWARDEN_VERSION=latest

# Set to true only long enough to create your account(s), then set false and
# run `docker compose up -d`.
SIGNUPS_ALLOWED=true

# Admin panel at /admin. Leave empty to keep it disabled. To enable, generate
# an argon2 hash (see README) and paste it here, escaping every $ as $$.
ADMIN_TOKEN=

# --- Remote backup (PLANNED, NOT IMPLEMENTED YET) -------------------------
# scripts/backup.sh is currently a stub. These settings are reserved so the
# backup can be turned on later without restructuring anything.
BACKUP_ENABLED=false
BACKUP_LOCAL_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCP_HOST=
BACKUP_SCP_PORT=22
BACKUP_SCP_USER=
BACKUP_SCP_PATH=
BACKUP_SCP_KEY=~/.ssh/id_ed25519_bitwarden_backup
